{{#> layout preheader=(concat matchTitle ", " matchKickoffLabel ". Fizetve: " totalLabel ".") footerNote="A jegyeid és a QR-kódok bármikor megnyithatók a KTE Jegyportálon, a fiókodban."}}
{{#> h1}}Megvan a jegyed: {{matchTitle}}{{/h1}}
{{#> p}}Szia <strong>{{recipientName}}</strong>, köszönjük a vásárlást! A fizetés megtörtént, az alábbi helyek a tieid.{{/p}}
{{#> details}}
{{> row label="Mérkőzés" value=matchTitle}}
{{> row label="Időpont" value=matchKickoffLabel}}
{{> row label="Helyszín" value=matchVenue}}
{{#each tickets}}
{{> row label="Hely" value=seatLabel}}
{{#if gateLabel}}{{> row label="Belépés" value=gateLabel}}{{/if}}
{{> row label="Kategória / ár" value=(concat categoryLabel " · " pricePaidLabel)}}
{{/each}}
{{> row label="Összesen fizetve" value=totalLabel}}
{{> row label="Gyűjtött hűségpont" value=(concat "+" pointsEarned " pont")}}
{{/details}}
{{#> p muted=true}}Belépéskor mutasd be a QR-kódot a telefonodon vagy kinyomtatva. Minden kód csak egyszer használható.{{/p}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{{#each qrImageDataUrls}}
<tr>
<td align="center" style="padding:12px 0; border-top:1px solid #efecf3; font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:20px; color:#5b5566;">
{{seatLabel}}<br />
<img src="{{dataUrl}}" alt="Belépő QR-kód: {{seatLabel}}" width="180" height="180" style="display:block; margin:8px auto 0; width:180px; height:180px; border:1px solid #e1d5ec;" />
</td>
</tr>
{{/each}}
</table>
{{> button url=ticketsUrl label="Jegyeim megnyitása"}}
{{/layout}}
