{{#if isLender}}
{{#> layout preheader=(concat borrowerName " elfogadta a helyedet: " matchTitle ", " matchKickoffLabel ".") footerNote="A bérleted a következő meccsen újra a megszokott módon működik."}}
{{#> h1}}{{borrowerName}} elfogadta a helyedet{{/h1}}
{{#> p}}Szia <strong>{{recipientName}}</strong>,{{/p}}
{{#> p}}<strong>{{borrowerName}}</strong> elfogadta a kölcsönzési meghívódat {{article matchTitle}} <strong>{{matchTitle}}</strong> mérkőzésre. Ezzel a te saját belépésed erre a meccsre érvénytelen, a helyet {{borrowerName}} használja.{{/p}}
{{#> details}}
{{> row label="Elfogadta" value=borrowerName}}
{{> row label="Mérkőzés" value=matchTitle}}
{{> row label="Időpont" value=matchKickoffLabel}}
{{> row label="Helyszín" value=matchVenue}}
{{> row label="Hely" value=seatLabel}}
{{/details}}
{{#> p muted=true}}A bérleted a következő meccsen újra működik, a mostani átadás csak erre az egy meccsre szól.{{/p}}
{{> button url=qrUrl label="Kölcsön megtekintése"}}
{{/layout}}
{{else}}
{{#> layout preheader=(concat lenderName " helyét kaptad: " matchTitle ", " matchKickoffLabel ". A belépőd QR-kódja ebben a levélben van.") footerNote="A hely csak erre az egy meccsre szól. Ha a bérlet gazdája visszavonja, a QR-kód érvényét veszti, erről értesítést kapsz."}}
{{#> h1}}Itt a belépőd: {{matchTitle}}{{/h1}}
{{#> p}}Szia <strong>{{recipientName}}</strong>,{{/p}}
{{#> p}}Elfogadtad <strong>{{lenderName}}</strong> bérletes helyét {{article matchTitle}} <strong>{{matchTitle}}</strong> mérkőzésre. Az alábbi QR-kóddal léphetsz be a stadionba.{{/p}}
{{#> details}}
{{> row label="Ki adta át" value=lenderName}}
{{> row label="Mérkőzés" value=matchTitle}}
{{> row label="Időpont" value=matchKickoffLabel}}
{{> row label="Helyszín" value=matchVenue}}
{{> row label="Hely" value=seatLabel}}
{{/details}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td align="center" style="padding:4px 0 8px;">
<img src="{{qrDataUrl}}" alt="Belépő QR-kód" width="200" height="200" style="display:block; width:200px; height:200px; border:1px solid #e1d5ec;" />
</td>
</tr>
</table>
{{> button url=qrUrl label="Belépő megnyitása"}}
{{/layout}}
{{/if}}
