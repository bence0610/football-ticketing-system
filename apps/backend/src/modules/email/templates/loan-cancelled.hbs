{{#if isLender}}
{{#> layout preheader=(concat "A kölcsön visszavonva: " matchTitle ", " matchKickoffLabel ".")}}
{{#> h1}}A kölcsön visszavonva{{/h1}}
{{#> p}}{{#if recipientName}}Szia <strong>{{recipientName}}</strong>,{{else}}Szia!{{/if}}{{/p}}
{{#> p}}{{Article matchTitle}} <strong>{{matchTitle}}</strong> mérkőzésre létrehozott bérletkölcsön sikeresen visszavonva.{{/p}}
{{#> details}}
{{> row label="Mérkőzés" value=matchTitle}}
{{> row label="Időpont" value=matchKickoffLabel}}
{{/details}}
{{#if reason}}{{#> p muted=true}}Indok: {{reason}}{{/p}}{{/if}}
{{/layout}}
{{else}}
{{#> layout amber=true preheader=(concat lenderName " visszavonta a kölcsönt: " matchTitle ", " matchKickoffLabel ".") footerNote="Neked nincs további teendőd."}}
{{#> h1}}{{lenderName}} visszavonta a kölcsönt{{/h1}}
{{#> p}}{{#if recipientName}}Szia <strong>{{recipientName}}</strong>,{{else}}Szia!{{/if}}{{/p}}
{{#> p}}<strong>{{lenderName}}</strong> visszavonta {{article matchTitle}} <strong>{{matchTitle}}</strong> mérkőzésre szóló bérletkölcsönt.{{#if qrIssued}} A korábban kapott QR-kód nem fog működni a beléptetésnél.{{else}} A meghívó már nem érvényes.{{/if}}{{/p}}
{{#> details}}
{{> row label="Mérkőzés" value=matchTitle}}
{{> row label="Időpont" value=matchKickoffLabel}}
{{/details}}
{{#> note alert=true}}<strong>Nem fizettél semmit, ezért nincs mit visszatéríteni.</strong>{{#if qrIssued}} A QR-kódot ne használd, a kapunál nem fogják elfogadni.{{/if}}{{/note}}
{{#if reason}}{{#> p muted=true}}Indok: {{reason}}{{/p}}{{/if}}
{{/layout}}
{{/if}}
