{{!-- Callout box. Param: alert (true => amber warning tone, else brand tint). Content is the block. --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0 0;">
<tr>
<td bgcolor="{{#if alert}}#fbf1e0{{else}}#f3edf8{{/if}}" style="background-color:{{#if alert}}#fbf1e0{{else}}#f3edf8{{/if}}; border:1px solid {{#if alert}}#f0dcb8{{else}}#e1d5ec{{/if}}; border-radius:8px; padding:14px 18px; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:{{#if alert}}#6b4100{{else}}#14121a{{/if}};">
{{> @partial-block}}
</td>
</tr>
</table>
