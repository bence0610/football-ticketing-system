{{!-- The one primary action. Params: url, label. VML round-rect for Outlook (Word ignores padding on <a>), padded <a> everywhere else. --}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 8px;">
<tr>
<td align="center" bgcolor="#4a1d6a" style="background-color:#4a1d6a; border-radius:8px;">
<!--[if mso]>
<v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{url}}" style="height:48px; v-text-anchor:middle; width:280px;" arcsize="12%" stroke="f" fillcolor="#4a1d6a">
<w:anchorlock/>
<center style="color:#ffffff; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold;">{{label}}</center>
</v:roundrect>
<![endif]-->
<!--[if !mso]><!-- -->
<a href="{{url}}" class="kte-cta" style="display:inline-block; background-color:#4a1d6a; color:#ffffff; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:20px; font-weight:bold; text-decoration:none; padding:14px 32px; border-radius:8px; text-align:center;">{{label}}</a>
<!--<![endif]-->
</td>
</tr>
</table>
