{{!-- One row of the two-column detail table. Params: label, value. Stacks on narrow screens. --}}
<tr>
<td class="kte-stack kte-label" width="38%" valign="top" style="width:38%; padding:7px 12px 7px 0; font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:20px; color:#5b5566;">{{label}}</td>
<td class="kte-stack" valign="top" style="padding:7px 0; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:22px; font-weight:bold; color:#14121a;">{{value}}</td>
</tr>
